From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: SVN Service <centroid@centroid.is>
Date: Sat, 12 Sep 2026 22:00:00 +0000
Subject: [PATCH] vnc: honour keymap variant and options, and resync reused
 seats

The VNC backend compiles its own keymap for the per-client seats out of
the compositor's rule names, but copies only rules, model and layout:

  backend->xkb_rule_name.rules = strdup(compositor->xkb_names.rules);
  backend->xkb_rule_name.model = strdup(compositor->xkb_names.model);
  backend->xkb_rule_name.layout = strdup(compositor->xkb_names.layout);

keymap_variant and keymap_options from weston.ini's [keyboard] reach the
panel's own libinput seat and are silently dropped for every VNC client.
With keymap_layout=is,us,pl and keymap_options=grp:alt_shift_toggle, the
panel keyboard cycles layouts on Alt+Shift and a VNC keyboard never
leaves the first one: the group switch is an xkb option, and the VNC
keymap was built without it. Copy both, NULL-guarded because they are
NULL unless configured, and free all five names in vnc_destroy(), which
never freed the first three either.

Second, a seat taken back out of the pool (0004). Parking it runs
weston_seat_release_keyboard(), whose weston_keyboard_reset_state()
replaces the xkb_state with a fresh one -- group 0, nothing held -- but
leaves keyboard->modifiers, the serialized copy that
weston_keyboard_set_focus() sends a newly focused client, holding the
previous client's group and locks. The next client is told it is on
layout 2 with Caps Lock on while the seat actually types layout 1 in
lower case, until its first modifier change resyncs them. Calling
notify_modifiers() once on reuse re-serializes the real state into that
copy before any focus is set. A freshly created seat has no stale copy
and is left alone.
---
 libweston/backend-vnc/vnc.c | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/libweston/backend-vnc/vnc.c b/libweston/backend-vnc/vnc.c
index 8729b04..af8e426 100644
--- a/libweston/backend-vnc/vnc.c
+++ b/libweston/backend-vnc/vnc.c
@@ -1562,6 +1562,7 @@ vnc_new_client(struct nvnc_client *client)
 	struct vnc_peer *peer;
 	struct vnc_seat *seat;
 	const char *seat_name = "VNC Client";
+	bool reused = false;
 
 	weston_log("New VNC client connected\n");
 
@@ -1574,6 +1575,7 @@ vnc_new_client(struct nvnc_client *client)
 		seat = container_of(backend->seat_pool.next, struct vnc_seat,
 				    link);
 		wl_list_remove(&seat->link);
+		reused = true;
 	} else {
 		seat = xzalloc(sizeof(*seat));
 		backend->creating_peer_seat = true;
@@ -1586,6 +1588,18 @@ vnc_new_client(struct nvnc_client *client)
 	weston_seat_init_pointer(peer->seat);
 	weston_seat_init_keyboard(peer->seat, backend->xkb_keymap);
 
+	/*
+	 * Parking the seat reset its xkb_state to group 0 with nothing held
+	 * (weston_keyboard_reset_state), but not keyboard->modifiers, the
+	 * serialized copy that weston_keyboard_set_focus() hands a newly
+	 * focused client. Left alone, the next client inherits the last one's
+	 * layout group and locks on paper while the seat types group 0.
+	 * notify_modifiers() re-serializes the real state into that copy.
+	 */
+	if (reused)
+		notify_modifiers(peer->seat,
+				 wl_display_next_serial(backend->compositor->wl_display));
+
 	if (wl_list_empty(&output->peers))
 		weston_output_power_on(&output->base);
 
@@ -1801,6 +1815,12 @@ vnc_destroy(struct weston_backend *base)
 
 	xkb_keymap_unref(backend->xkb_keymap);
 
+	free((char *) backend->xkb_rule_name.rules);
+	free((char *) backend->xkb_rule_name.model);
+	free((char *) backend->xkb_rule_name.layout);
+	free((char *) backend->xkb_rule_name.variant);
+	free((char *) backend->xkb_rule_name.options);
+
 	if (backend->debug)
 		weston_log_scope_destroy(backend->debug);
 
@@ -2101,6 +2121,17 @@ vnc_backend_create(struct weston_compositor *compositor,
 	backend->xkb_rule_name.rules = strdup(compositor->xkb_names.rules);
 	backend->xkb_rule_name.model = strdup(compositor->xkb_names.model);
 	backend->xkb_rule_name.layout = strdup(compositor->xkb_names.layout);
+	/*
+	 * variant and options are NULL unless weston.ini's [keyboard] sets
+	 * them, and strdup(NULL) is undefined. Without options the VNC seats
+	 * never see the grp: group-switch option the panel's own seat honours.
+	 */
+	if (compositor->xkb_names.variant)
+		backend->xkb_rule_name.variant =
+			strdup(compositor->xkb_names.variant);
+	if (compositor->xkb_names.options)
+		backend->xkb_rule_name.options =
+			strdup(compositor->xkb_names.options);
 
 	backend->xkb_keymap = xkb_keymap_new_from_names(
 					backend->compositor->xkb_context,
-- 
