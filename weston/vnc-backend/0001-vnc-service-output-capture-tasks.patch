From ff1045010298ae448bf998dcb53ebce6876b7ad2 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?J=C3=B3n=20Bjarni=20Bjarnason?= <jon@centroid.is>
Date: Tue, 1 Sep 2026 13:10:10 +0000
Subject: [PATCH] vnc: service output capture tasks

weston-screenshooter captures every output. On the VNC output the task
was never serviced, because vnc_output_repaint() only invokes the
renderer when the primary plane has damage, and the renderer is what
drains WESTON_OUTPUT_CAPTURE_SOURCE_FRAMEBUFFER tasks. Filing a capture
does schedule a repaint, but schedules no damage, so the repaint runs
with an empty region, skips vnc_update_buffer(), and reaches

  weston_output_capture_info_repaint_done()
    assert(wl_list_empty(&ci->pending_capture_list))

with the task still pending, aborting the compositor.

Invoke the renderer when a renderer capture task is outstanding, the
same way backend-drm and backend-pipewire already do.

The output also powers itself off when the last VNC client leaves, and
weston_output_check_repaint() drops repaints on a powered-off output
before it looks at capture state, so a task filed after that point is
stranded and the screenshot blocks. Keep the output on while one is
outstanding.
---
 libweston/backend-vnc/vnc.c | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/libweston/backend-vnc/vnc.c b/libweston/backend-vnc/vnc.c
index 6d3f674..0daf3d3 100644
--- a/libweston/backend-vnc/vnc.c
+++ b/libweston/backend-vnc/vnc.c
@@ -52,6 +52,7 @@
 #include <libweston/libweston.h>
 #include <libweston/backend-vnc.h>
 #include <libweston/weston-log.h>
+#include "output-capture.h"
 #include "pixel-formats.h"
 #include "pixman-renderer.h"
 #include "renderer-gl/gl-renderer.h"
@@ -1064,7 +1065,14 @@ vnc_output_repaint(struct weston_output *base)
 
 	assert(output);
 
-	if (wl_list_empty(&output->peers))
+	/*
+	 * Powering the output off makes weston_output_check_repaint() drop
+	 * every subsequent repaint, so this function would never run again
+	 * and a capture task filed in the meantime would be stranded with
+	 * nothing to service it. Stay on while one is outstanding.
+	 */
+	if (wl_list_empty(&output->peers) &&
+	    !weston_output_has_renderer_capture_tasks(base))
 		weston_output_power_off(base);
 
 	vnc_output_update_cursor(output);
@@ -1073,7 +1081,16 @@ vnc_output_repaint(struct weston_output *base)
 
 	weston_output_flush_damage_for_primary_plane(base, &damage);
 
-	if (pixman_region32_not_empty(&damage)) {
+	/*
+	 * The renderer is what services framebuffer capture tasks, so it has
+	 * to be invoked even when there is nothing to redraw. Otherwise the
+	 * task is still on the output's pending_capture_list when
+	 * weston_output_capture_info_repaint_done() asserts that list empty
+	 * at the end of the repaint cycle, and the compositor aborts.
+	 * backend-drm and backend-pipewire take the same precaution.
+	 */
+	if (pixman_region32_not_empty(&damage) ||
+	    weston_output_has_renderer_capture_tasks(base)) {
 		vnc_update_buffer(output->display, &damage);
 	}
 
