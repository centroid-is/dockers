+	wl_list_for_each_safe(wtask, wtask_next, &backend->clipboard_writes, link)
+		vnc_clipboard_write_destroy(wtask);
+
+	wl_list_for_each_safe(cseat, cseat_next, &backend->clipboard_seats, link)
+		vnc_clipboard_seat_free(cseat);
+}
